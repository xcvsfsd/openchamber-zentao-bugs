{
  "name": "openchamber-zentao-bugs",
  "version": "0.1.0",
  "description": "禅道指派Bug面板：前10列表、提取发会话、快速指派、浏览器打开",
  "private": true,
  "type": "module",
  "license": "MIT",
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.3.3"
    },
    "contributes": {
      "panel": {
        "id": "zentao-bugs",
        "name": "禅道 Bug",
        "icon": "bug",
        "entry": "panel/index.html"
      },
      "statusSection": {
        "entry": "status/index.html",
        "title": "禅道",
        "height": 76
      },
      "service": {
        "entry": "service/main.js",
        "runtime": "host"
      }
    }
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "pinyin-pro": "^3.27.1"
  },
  "devDependencies": {
    "@openchamber/sdk": "^2.3.3",
    "@types/bun": "^1.4.2",
    "typescript": "^5.9.2"
  }
}
